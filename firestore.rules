rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated (anonymous) user may write only their own session doc.
    // Reads are blocked from clients; analysis uses the Admin SDK which bypasses rules.
    match /{collection}/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if false;
    }
  }
}
